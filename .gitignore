.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
.env*.local

# Retained local migration artifacts (not part of the active Next.js/Vercel app)
/.openai/
/build/
/examples/
/worker/
/vite.config.ts
/drizzle-legacy-unapplied-workos/

