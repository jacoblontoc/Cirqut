# Neon Postgres
# Use the pooled connection string at runtime and the direct string for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Neon Managed Better Auth
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Public application configuration
APP_URL=http://localhost:3001
AUTH_SIGNUP_MODE=waitlist
NEXT_PUBLIC_AUTH_SOCIAL_ENABLED=false

# Reserved for the future server-only model gateway. No model calls exist yet.
PORTKEY_API_KEY=replace-me-when-model-work-begins
